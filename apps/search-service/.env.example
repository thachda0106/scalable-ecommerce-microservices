# ─── Application ──────────────────────────────────
PORT=3000
LOG_LEVEL=debug

# ─── OpenSearch ───────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ─── Kafka ────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=search-service-product-sync

# ─── Redis (optional) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
