# ─────────────────────────────────────────────────────────────
# Notification Service Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
# Name of the service (used in logs and Kafka client ID fallback)
APP_NAME=notification-service

# HTTP port for the REST API and Prometheus /metrics endpoint
PORT=3000

# ── Kafka (Message Broker) ───────────────────────────────────
# Kafka client identifier for this service instance
KAFKA_CLIENT_ID=notification-service

# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:29092

# Consumer group IDs for each event topic
KAFKA_GROUP_USER_EVENTS=notification-service-user-events
KAFKA_GROUP_ORDER_EVENTS=notification-service-order-events
KAFKA_GROUP_CART_EVENTS=notification-service-cart-events

# Kafka topic names for consuming domain events
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_TOPIC_ORDER_EVENTS=order.events
KAFKA_TOPIC_CART_EVENTS=cart.events

# Kafka Dead Letter Queue topic for exhausted notifications
KAFKA_DLQ_TOPIC=notification.dlq

# ── Redis (optional, for future caching / rate limiting) ─────
# Redis host for caching and rate limiting
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# ── Email (SendGrid) ────────────────────────────────────────
# SendGrid API key for sending transactional emails
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxx

# Default "from" email address
SMTP_FROM=noreply@example.com

# ── SMS (Twilio) ─────────────────────────────────────────────
# Twilio Account SID
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio sender phone number (E.164 format)
TWILIO_FROM_NUMBER=+15551234567

# ── Push Notifications (Firebase) ────────────────────────────
# Firebase Cloud Messaging server key
FIREBASE_SERVER_KEY=AAAAxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (optional, for future persistence) ──────────────
# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/notifications

# ── Retry & DLQ ──────────────────────────────────────────────
# Retry scheduler polling interval in milliseconds
RETRY_INTERVAL_MS=10000

# DLQ processor polling interval in milliseconds
DLQ_INTERVAL_MS=30000
