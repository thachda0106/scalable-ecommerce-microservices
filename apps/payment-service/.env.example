# Application Metadata
APP_NAME=payment-service
# The port the REST API server will listen on
PORT=3004

# Database configuration
# PostgreSQL connection string for the payment service database
DATABASE_URL=postgresql://user:password@localhost:5432/payment_db
# Set to 'true' only for development — use migrations in production
DB_SYNC=false

# Redis Configuration
# Hostname of the Redis server (used for caching/rate-limiting if applicable)
REDIS_HOST=localhost
# Port of the Redis server
REDIS_PORT=6379

# Kafka messaging configuration
# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:29092

# Payment Provider details
# Select the active payment provider: STRIPE, PAYPAL, or MOCK
DEFAULT_PAYMENT_PROVIDER=MOCK
# API key for the chosen payment provider (not needed if MOCK)
PAYMENT_PROVIDER_API_KEY=sk_test_123456789
# The max time a payment request should be allowed to run
PAYMENT_TIMEOUT_MS=30000

# Service Authentication
# Internal API key for service-to-service communication
INTERNAL_API_KEY=your-internal-api-key-here
