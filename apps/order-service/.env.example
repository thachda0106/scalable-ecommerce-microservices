# ──────────────────────────────────────────────────────────
# Order Service — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and update the values for your environment.
# All variables with defaults shown are optional in development.

# ──────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────

# Display name for the service (used in logs and health checks)
APP_NAME=order-service

# HTTP port the service listens on
PORT=3006

# Environment mode: 'development' or 'production'
# In development: TypeORM synchronize + query logging are enabled
# In production: both are disabled for safety and performance
NODE_ENV=development

# ──────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────

# Full PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_db

# ──────────────────────────────────────────────────────────
# Kafka
# ──────────────────────────────────────────────────────────

# Comma-separated list of Kafka broker addresses
# Used by: outbox relay, event consumers, external service publishers
KAFKA_BROKERS=localhost:29092

# Kafka client identifier (used for producer connections)
KAFKA_CLIENT_ID=order-service

# Kafka consumer group ID (used for consuming payment/inventory events)
KAFKA_GROUP_ID=order-service-group

# ──────────────────────────────────────────────────────────
# Redis (optional — for caching/session if enabled)
# ──────────────────────────────────────────────────────────

# Redis server hostname
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────
# Order Configuration
# ──────────────────────────────────────────────────────────

# Timeout in seconds for orders awaiting payment before auto-cancellation
# Default: 900 (15 minutes)
ORDER_TIMEOUT_SECONDS=900

# ──────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────

# Logging level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Enable/disable Prometheus metrics endpoint at /metrics
METRICS_ENABLED=true
