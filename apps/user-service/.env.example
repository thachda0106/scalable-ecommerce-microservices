# ─── Server ───────────────────────────────────────────────
PORT=3003
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=user_service

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=user-service
KAFKA_GROUP_ID=user-service-group

# ─── Rate Limiting ───────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
