# =============================================================================
# Ecommerce Microservices — Environment Variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file: cp docker/.env.example docker/.env
#   2. Edit docker/.env with your values (never commit .env to git!)
#   3. Run: docker-compose -f docker/docker-compose.yml up -d
#
# NOTE: Defaults are set in docker-compose.yml using ${VAR:-default} syntax.
#       You only need to override values you want to change.
# =============================================================================

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432

# For NestJS services connecting from the host machine during local dev
DATABASE_URL=postgresql://postgres:postgres_dev_secret@localhost:5432/ecommerce

# =============================================================================
# Redis
# =============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret

# For NestJS services connecting from the host machine
REDIS_URL=redis://:redis_dev_secret@localhost:6379

# =============================================================================
# Kafka
# =============================================================================
# External port is what your HOST MACHINE (and local NestJS apps) connect to.
KAFKA_EXTERNAL_PORT=9094
KAFKA_DEFAULT_PARTITIONS=3
KAFKA_SASL_USERNAME=ecommerce
KAFKA_SASL_PASSWORD=ecommerce-secret

# For NestJS services running on host machine (outside Docker)
KAFKA_BROKERS=localhost:9094

# =============================================================================
# OpenSearch
# =============================================================================
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=Admin123!

# For NestJS services running on host machine
OPENSEARCH_URL=http://localhost:9200

# =============================================================================
# Developer UI Ports (local dev only — not used by application services)
# =============================================================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

REDISINSIGHT_PORT=8001

KAFKA_UI_PORT=8080

OPENSEARCH_DASHBOARDS_PORT=5601
